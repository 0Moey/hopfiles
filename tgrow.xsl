<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0" xmlns:exsl="http://exslt.org/common" extension-element-prefixes="exsl"><xsl:template name="grow"><xsl:param name="n"/><xsl:choose><xsl:when test="$n = 0"><n/></xsl:when><xsl:otherwise><xsl:variable name="r"><xsl:call-template name="grow"><xsl:with-param name="n" select="$n - 1"/></xsl:call-template></xsl:variable><xsl:copy-of select="exsl:node-set($r)/*"/><xsl:copy-of select="exsl:node-set($r)/*"/></xsl:otherwise></xsl:choose></xsl:template></xsl:stylesheet>
